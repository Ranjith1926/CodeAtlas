# Copy to .env and adjust for your setup. Expo inlines any EXPO_PUBLIC_*
# variable into the JS bundle at build/start time.

# Android emulator default (10.0.2.2 aliases the host machine's localhost).
# Leave unset to use this default automatically.
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5212/api

# Physical device example — use your machine's LAN IP instead of localhost:
# EXPO_PUBLIC_API_URL=http://192.168.1.50:5212/api

# iOS simulator can usually reach the host directly via localhost:
# EXPO_PUBLIC_API_URL=http://localhost:5212/api

# Dev-only: fall back to local fixture data when a real API call fails and
# the backend isn't reachable yet. Never set this in production.
# EXPO_PUBLIC_USE_FIXTURES=1
