{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AiProvider": "Gemini",
  "OpenAi": {
    "ApiKey": "",
    "Model": "gpt-4o-mini"
  },
  "Gemini": {
    "ApiKey": "",
    "Model": "gemini-3.5-flash-lite"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=CodeAtlasDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "SigningKey": "set-via-appsettings.Development.json-or-an-environment-variable",
    "Issuer": "CodeAtlas.Api",
    "Audience": "CodeAtlas.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  }
}
